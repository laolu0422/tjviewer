<Window x:Class="TjViewer.Client.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TjViewer.Client.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TjViewer - 远程控制" Height="720" Width="1120" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0" Title="TjViewer · 远程控制"/>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
            <WrapPanel Orientation="Horizontal">
                <Button Content="断开连接" Style="{StaticResource DangerButton}" Click="OnDisconnect" VerticalAlignment="Center"/>

                <TextBlock Text="帧率" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <Slider x:Name="FpsSlider" Width="130" Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="OnQualitySliderChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="FpsText" Text="30 FPS" Width="66" VerticalAlignment="Center" Margin="8,0,0,0"/>

                <TextBlock Text="码率" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,8,0"/>
                <Slider x:Name="BitrateSlider" Width="130" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="OnQualitySliderChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="BitrateText" Text="6 Mbps" Width="72" VerticalAlignment="Center" Margin="8,0,0,0"/>

                <ToggleButton x:Name="AdaptiveBtn" Content="自适应" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"
                              Checked="OnAdaptiveChecked" Unchecked="OnAdaptiveUnchecked"/>
                <ToggleButton x:Name="LockBtn" Content="锁定" Margin="6,0,0,0" VerticalAlignment="Center"
                              Checked="OnLockChecked" Unchecked="OnLockUnchecked"/>
                <ToggleButton x:Name="MicBtn" Content="麦克风" Margin="6,0,0,0" VerticalAlignment="Center" Checked="OnMicOn" Unchecked="OnMicOff"/>
                <Button x:Name="FileBtn" Content="发送文件" Margin="6,0,0,0" VerticalAlignment="Center" Click="OnSendFile"/>

                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="9,3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PathText" Text="连接中…" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="ModeBadge" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="9,3" Margin="6,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="观看模式" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="StatusText" Text="正在建立连接…" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource VideoBgBrush}">
            <Image x:Name="VideoImage" Stretch="Uniform"
                   MouseMove="OnMouseMove" MouseDown="OnMouseDown" MouseUp="OnMouseUp" MouseWheel="OnMouseWheel"/>
        </Border>

        <TextBlock x:Name="FooterText" Grid.Row="3" Text="鼠标与键盘操作实时传至被控端；Alt+Tab 等系统快捷键会转发到被控端"
                   Style="{StaticResource SecondaryText}" FontSize="12" Margin="12,6"/>
    </Grid>
</Window>
