<Window x:Class="TjViewer.Client.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TjViewer - 远程控制" Height="680" Width="1024" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel Orientation="Horizontal">
                <Button Content="断开连接" Style="{StaticResource DangerButton}" Click="OnDisconnect"/>
                <TextBlock Text="画质" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox x:Name="QualityBox" Width="88" VerticalAlignment="Center" SelectionChanged="OnQualityChanged">
                    <ComboBoxItem>高</ComboBoxItem>
                    <ComboBoxItem>中</ComboBoxItem>
                    <ComboBoxItem>低</ComboBoxItem>
                    <ComboBoxItem>极低</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="帧率" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox x:Name="FpsBox" Width="76" VerticalAlignment="Center" SelectionChanged="OnFpsChanged">
                    <ComboBoxItem>30</ComboBoxItem>
                    <ComboBoxItem>25</ComboBoxItem>
                    <ComboBoxItem>20</ComboBoxItem>
                    <ComboBoxItem>15</ComboBoxItem>
                </ComboBox>
                <ToggleButton x:Name="AdaptiveBtn" Content="自适应" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"
                              Checked="OnAdaptiveChecked" Unchecked="OnAdaptiveUnchecked"/>
                <ToggleButton x:Name="LockBtn" Content="锁定" Margin="6,0,0,0" VerticalAlignment="Center"
                              Checked="OnLockChecked" Unchecked="OnLockUnchecked"/>
                <ToggleButton x:Name="MicBtn" Content="麦克风" Margin="6,0,0,0" VerticalAlignment="Center" Checked="OnMicOn" Unchecked="OnMicOff"/>
                <Button Content="发送文件" Margin="6,0,0,0" VerticalAlignment="Center" Click="OnSendFile"/>
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="9,3" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PathText" Text="连接中…" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="StatusText" Text="正在建立连接…" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource VideoBgBrush}">
            <Image x:Name="VideoImage" Stretch="Uniform"
                   MouseMove="OnMouseMove" MouseDown="OnMouseDown" MouseUp="OnMouseUp" MouseWheel="OnMouseWheel"/>
        </Border>
        <TextBlock Grid.Row="2" Text="鼠标与键盘操作实时传至被控端（扫描码注入）" Style="{StaticResource SecondaryText}" FontSize="12" Margin="12,6"/>
    </Grid>
</Window>
