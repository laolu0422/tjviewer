<Window x:Class="TjViewer.Client.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TjViewer - 远程控制" Height="640" Width="960" WindowStartupLocation="CenterScreen"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#EEE">
            <Button Content="断开连接" Padding="8,4" Margin="6" Click="OnDisconnect"/>
            <TextBlock x:Name="StatusText" Text="正在建立直连…" VerticalAlignment="Center" Margin="8,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#111" Margin="6">
            <Image x:Name="VideoImage" Stretch="Uniform"
                   MouseMove="OnMouseMove" MouseDown="OnMouseDown" MouseUp="OnMouseUp" MouseWheel="OnMouseWheel"/>
        </Border>
        <TextBlock Grid.Row="2" Text="鼠标/键盘操作将实时传至被控端（扫描码注入）。" Foreground="Gray" Margin="6"/>
    </Grid>
</Window>
