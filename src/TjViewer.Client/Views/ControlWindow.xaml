<Window x:Class="TjViewer.Client.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TjViewer - 远程控制" Height="640" Width="960" WindowStartupLocation="CenterScreen"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#EEE">
            <Button Content="断开连接" Padding="8,4" Margin="6" Click="OnDisconnect"/>
            <TextBlock Text="画质:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <ComboBox x:Name="QualityBox" Width="96" Margin="0,4" SelectionChanged="OnQualityChanged">
                <ComboBoxItem>自适应</ComboBoxItem>
                <ComboBoxItem>高</ComboBoxItem>
                <ComboBoxItem>中</ComboBoxItem>
                <ComboBoxItem>低</ComboBoxItem>
                <ComboBoxItem>极低</ComboBoxItem>
            </ComboBox>
            <ToggleButton x:Name="MicBtn" Content="麦克风" Margin="8,4" Padding="6,2" Checked="OnMicOn" Unchecked="OnMicOff"/>
            <TextBlock x:Name="StatusText" Text="正在建立直连…" VerticalAlignment="Center" Margin="8,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#111" Margin="6">
            <Image x:Name="VideoImage" Stretch="Uniform"
                   MouseMove="OnMouseMove" MouseDown="OnMouseDown" MouseUp="OnMouseUp" MouseWheel="OnMouseWheel"/>
        </Border>
        <TextBlock Grid.Row="2" Text="鼠标/键盘操作将实时传至被控端（扫描码注入）。" Foreground="Gray" Margin="6"/>
    </Grid>
</Window>
