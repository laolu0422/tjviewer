<Window x:Class="TjViewer.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TjViewer.Client.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TjViewer" Height="600" Width="880" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0" Title="TjViewer"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：品牌与服务器地址 -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="30,34,30,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="TjViewer" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="轻量远程控制 · 低延迟 · 安全" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="局域网示例：http://192.168.1.70:5000" Style="{StaticResource SecondaryText}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="修改后会自动保存，下次启动沿用。" Style="{StaticResource SecondaryText}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="TjViewer · 仅用于授权设备" Style="{StaticResource SecondaryText}" FontSize="11"/>
                </Grid>
            </Border>

            <!-- 右侧：登录 / 注册 / 找回密码 -->
            <Grid Grid.Column="1" Margin="30,22,30,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0">
                    <TabItem Header="登录">
                        <StackPanel>
                            <TextBlock Text="用户名或邮箱" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="LoginPassword" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <CheckBox Content="记住账号密码" IsChecked="{Binding RememberCredentials}" Margin="0,0,20,0"/>
                                <CheckBox Content="自动登录" IsChecked="{Binding AutoLogin}"/>
                            </StackPanel>
                            <Button Content="登录" Style="{StaticResource PrimaryButton}" Click="OnLogin" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="注册">
                        <StackPanel>
                            <TextBlock Text="用户名（3–32 位字母/数字/下划线）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding RegUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Text="邮箱（必填）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            <TextBlock Text="密码（至少 8 位，含字母与数字）" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="RegPassword" Margin="0,0,0,10"/>
                            <CheckBox Content="注册后记住账号密码" IsChecked="{Binding RememberCredentials}" Margin="0,0,0,12"/>
                            <Button Content="创建账户" Style="{StaticResource PrimaryButton}" Click="OnRegister" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="找回密码">
                        <StackPanel>
                            <TextBlock Text="注册邮箱" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ResetEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                            <Button Content="发送重置邮件" Style="{StaticResource PrimaryButton}" Click="OnReset" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="重置链接将发送到邮箱，30 分钟内有效。需服务端已配置 SMTP。" Style="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap" Margin="2,12,2,0" MinHeight="18"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
