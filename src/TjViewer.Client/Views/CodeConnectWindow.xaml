<Window x:Class="TjViewer.Client.Views.CodeConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TjViewer.Client.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="连接码连接" Height="430" Width="460" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0" Title="连接码连接"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,16">
            <TextBlock Text="9 位数字连接码" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="CodeBox" MaxLength="9" FontFamily="Consolas" FontSize="18" Margin="0,0,0,12"/>

            <TextBlock Text="8 位验证码（每次连接后刷新，不会被保存）" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="PasswordBox" MaxLength="8" FontFamily="Consolas" FontSize="18" Margin="0,0,0,12"/>

            <CheckBox x:Name="RememberCheck" Content="记住连接码（不保存验证码）" Margin="0,0,0,14"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="仅观看" Margin="0,0,6,0" Click="OnWatch"/>
                <Button Grid.Column="1" Content="远程控制" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="OnControl"/>
            </Grid>

            <TextBlock x:Name="Hint" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
