<Window x:Class="TjViewer.Client.Views.CloseOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TjViewer.Client.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关闭 TjViewer" Height="330" Width="460" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0" Title="关闭 TjViewer"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,16">
            <TextBlock Text="你希望如何关闭 TjViewer？" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <Button Click="OnMinimize" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="最小化到系统托盘" FontWeight="SemiBold"/>
                    <TextBlock Text="仅隐藏主窗口，后台保持运行，可随时继续远程控制" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>

            <Button Click="OnExit" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="完全关闭" FontWeight="SemiBold"/>
                    <TextBlock Text="退出程序并终止所有关联后台进程，本次登录会话内不再自动启动" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>

            <CheckBox x:Name="RememberCheck" Content="记住我的选择，下次不再询问" Margin="0,0,0,14"/>

            <Button Content="取消" Click="OnCancel" HorizontalAlignment="Right" MinWidth="88"/>
        </StackPanel>
    </Grid>
</Window>
