<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题：紫 + 黑 -->
    <SolidColorBrush x:Key="BgBrush" Color="#0E0B16"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171226"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#221B38"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#332A4D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F1EDFA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A298C0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2C2350"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1D24"/>
    <SolidColorBrush x:Key="VideoBgBrush" Color="#060409"/>
</ResourceDictionary>
