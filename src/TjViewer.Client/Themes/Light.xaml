<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题：紫 + 白 -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F5FC"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EFEBF9"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E3DDF2"/>
    <SolidColorBrush x:Key="TextBrush" Color="#201A33"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6F6788"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EDE9FE"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="VideoBgBrush" Color="#0B0812"/>
</ResourceDictionary>
